# ===================================================================
# Data Board - Environment Variables Example
# Copy this file to .env.local for local development.
# ===================================================================

# -------------------------------------------------------------------
# Supabase Configuration (Required for database & auth)
# Get these from your Supabase project settings -> API
# -------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-supabase-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -------------------------------------------------------------------
# Dodo Payments (Required for paywall & automated license fulfillment)
# Get these from https://app.dodopayments.com
# -------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=dodo_live_or_test_key
DODO_PAYMENTS_PRODUCT_ID=pdt_your_product_id

# -------------------------------------------------------------------
# Google OAuth (Optional: for Google 1-tap sign-in)
# -------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# -------------------------------------------------------------------
# Custom SMTP Delivery (Optional: for founder onboarding drips & alerts)
# Can also be configured directly inside Admin -> Settings -> SMTP
# -------------------------------------------------------------------
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@databoard.in
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME="Guru Kalyan | Data Board"
SMTP_FROM_EMAIL=support@databoard.in

# -------------------------------------------------------------------
# Cloudflare D1 Storage / BYOC (Optional: for user SQLite edge storage)
# -------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# -------------------------------------------------------------------
# Telegram Edge Notifications (Optional: for system alerts)
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
