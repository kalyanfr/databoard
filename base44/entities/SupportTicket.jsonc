{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Short summary of the issue"
    },
    "message": {
      "type": "string",
      "description": "Full description from the user"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_review",
        "resolved"
      ],
      "default": "open"
    },
    "reply": {
      "type": "string",
      "description": "Admin response shown to the submitter"
    }
  },
  "required": [
    "subject",
    "message"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}